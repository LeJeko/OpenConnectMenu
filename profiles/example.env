# Configuration profile: settings that the macOS profile (.mobileconfig) ENFORCES on the app.
#
#   cp profiles/example.env profiles/my-organization.env      (ignored by git, except this template)
#   PROFILE=my-organization ./build.sh mobileconfig           ->  dist/OpenConnectMenu-my-organization.mobileconfig
#   PROFILE=work,lab ./build.sh mobileconfig                  ->  a single profile, with two configurations
#
# The profile is installed by hand (System Settings) or deployed through MDM. In the app, the configuration
# appears with a padlock and its enforced fields are greyed out. A field left empty is not enforced: the user sets it.
# The password and the TOTP secret are never part of a profile; the username only if you set it below.

# Name of the configuration, shown in the app (60 characters at most). Default: the name of this file.
VPN_NAME="Mon VPN"

# VPN server address (https:// required).
VPN_SERVER=https://vpn.example.com

# openconnect protocol: anyconnect, nc, gp, pulse, f5, fortinet or array (see Shared/Shared.swift).
# Leave empty not to enforce it (the user chooses; AnyConnect by default).
VPN_PROTOCOL=anyconnect

# Authentication group; leave empty not to enforce it.
VPN_AUTHGROUP=

# User-Agent sent to the server; leave empty to let openconnect pick the protocol's own.
VPN_USERAGENT=

# Username: set it only if it is the same for everyone. Left empty, each user enters their own.
VPN_USERNAME=
