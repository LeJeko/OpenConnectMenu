# Profil de configuration : réglages que le profil macOS (.mobileconfig) IMPOSE à l'app.
#
#   cp profiles/example.env profiles/mon-organisation.env     (ignoré par git, sauf ce modèle)
#   PROFILE=mon-organisation ./build.sh mobileconfig          ->  dist/OpenConnectMenu-mon-organisation.mobileconfig
#
# Le profil s'installe à la main (Réglages Système) ou se déploie par MDM. Dans l'app, les champs
# imposés sont grisés. Un champ laissé vide n'est pas imposé : l'utilisateur le règle lui-même.
# L'identifiant, le mot de passe et le secret TOTP ne sont jamais dans un profil.

# Adresse du serveur VPN (https:// obligatoire).
VPN_SERVER=https://vpn.example.com

# Protocole d'openconnect : anyconnect, nc, gp, pulse, f5, fortinet ou array (voir Shared/Shared.swift).
# Laisser vide pour ne pas l'imposer (l'utilisateur choisit ; AnyConnect par défaut).
VPN_PROTOCOL=anyconnect

# Groupe d'authentification ; laisser vide pour ne pas l'imposer.
VPN_AUTHGROUP=

# User-Agent envoyé au serveur ; laisser vide pour que openconnect choisisse celui du protocole.
VPN_USERAGENT=AnyConnect
