#!/bin/sh
# After the app has been replaced:
#  1. restart the helper. The old process is still running the old code; macOS notices
#     that the file on disk has changed and the app then refuses to talk to it
#     ("the helper is unreachable"). launchd restarts it with the new binary.
#  2. open the app for the user who is logged in: it was running before the update (marker written
#     by preinstall), or this is a reinstall ("brew upgrade" quits the app and uninstalls the old
#     version before installing), or this is a first installation, where opening the app is what
#     makes it register its helper and ask for the approvals.
LABEL=@HELPER_LABEL@
MARK=/private/tmp/@BUNDLE_ID@.relaunch

# If the helper is not (yet) registered, there is nothing to restart.
if launchctl print "system/$LABEL" >/dev/null 2>&1; then
    launchctl kickstart -k "system/$LABEL" >/dev/null 2>&1 || true
fi

uid=""
if [ -f "$MARK" ]; then
    uid=$(cat "$MARK")
    rm -f "$MARK"
else
    uid=$(stat -f %u /dev/console 2>/dev/null)   # user of the open session
fi

case "$uid" in
    ''|0|*[!0-9]*) ;;   # nothing, login window (root) or invalid value: launch nothing
    *) launchctl asuser "$uid" /usr/bin/open -a /Applications/OpenConnectMenu.app >/dev/null 2>&1 || true ;;
esac
exit 0
