# Configuration de build d'OpenConnectMenu.
#
#   cp config.env.example config.env     puis renseignez au minimum TEAM_ID et BUNDLE_ID
#
# config.env est ignoré par git : ces valeurs vous sont propres.
# Toute variable peut aussi être passée par l'environnement, qui prime sur ce fichier :
#   NOTARY_PROFILE=mon-profil ./build.sh pkg

# --- Obligatoire ---------------------------------------------------------------------------------

# Identifiant d'équipe du compte développeur Apple : 10 caractères
# (developer.apple.com/account, section « Membership details »).
TEAM_ID=ABCDE12345

# Identifiant de bundle de l'app, en notation DNS inversée. Celui du helper en est déduit
# (<BUNDLE_ID>.helper) ainsi que celui du paquet (<BUNDLE_ID>.pkg).
BUNDLE_ID=com.example.OpenConnectMenu

# --- Facultatif ----------------------------------------------------------------------------------

# Identités de signature. Par défaut, build.sh cherche dans votre trousseau les certificats
# « Developer ID Application » et « Developer ID Installer » de votre TEAM_ID. À renseigner s'il y
# en a plusieurs ; la liste s'obtient avec : security find-identity -v
#IDENTITY="Developer ID Application: Prénom Nom (ABCDE12345)"
#INSTALLER_IDENTITY="Developer ID Installer: Prénom Nom (ABCDE12345)"

# Profil notarytool (xcrun notarytool store-credentials). Sans lui, le paquet est signé mais pas
# notarisé. Le renseigner ici notarise CHAQUE paquet construit ; préférez le passer au besoin :
#   NOTARY_PROFILE=mon-profil ./build.sh pkg
#NOTARY_PROFILE=

# Profil de configuration macOS : nom du fichier profiles/<nom>.env (modèle : profiles/example.env)
# qui définit les réglages que ./build.sh mobileconfig impose à l'app (serveur, groupe d'authentification…).
# Il ne sert qu'à la commande mobileconfig ; le paquet de l'app reste le même pour tout le monde.
#PROFILE=
