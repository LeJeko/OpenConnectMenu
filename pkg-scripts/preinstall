#!/bin/sh
# Before the app is replaced: remember whether it was running (to relaunch it in
# postinstall), then quit it.
MARK=/private/tmp/@BUNDLE_ID@.relaunch
rm -f "$MARK"

pid=$(pgrep -x OpenConnectMenu 2>/dev/null | head -n 1)
if [ -n "$pid" ]; then
    # Owner of the process = the session in which to reopen the app.
    uid=$(ps -o uid= -p "$pid" 2>/dev/null | tr -d ' ')
    [ -n "$uid" ] && echo "$uid" > "$MARK"
    pkill -x OpenConnectMenu 2>/dev/null || true
fi
exit 0
